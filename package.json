{
  "name": "x402-web-intel-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de pago por uso (x402, USDC) que vende extracción web, auditorías SEO y análisis de texto a agentes de IA.",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "mcp:stdio": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/hono": "^2.27.0",
    "@x402/mcp": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "@x402/fetch": "^2.27.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.56.9",
    "wrangler": "^4.141.0"
  }
}
